# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=private-key.pem
GITHUB_WEBHOOK_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
# Modelo: claude-haiku-4-5 (barato, por defecto) o claude-sonnet-4-6 (mejor detección)
ANTHROPIC_MODEL=claude-haiku-4-5
# Tope de caracteres del diff por archivo (control de costo)
MAX_PATCH_CHARS=12000
# Máximo de comentarios inline publicados por PR (el resto va solo en el resumen)
MAX_INLINE_COMMENTS=15

# --- Controles de costo opcionales (todos "false" por defecto) ---
# Solo reporta bugs graves (🔴); omite 🟡/🔵
ONLY_CRITICAL_SEVERITY=false
# Solo llama a Claude si Ruff/ESLint ya encontró algo en el archivo
TWO_PASS_MODE=false
# Solo llama a Claude en archivos "riesgosos" (nombre sensible o diff grande)
RISKY_FILES_ONLY=false
RISKY_FILE_PATTERNS=auth,payment,pago,db,database,secret,crypto,session,token
RISKY_PATCH_SIZE=300

# LLM Observatory (métricas de uso/costo de Claude)
# Si OBSERVATORY_TOKEN está vacío, el bot funciona igual pero NO envía métricas.
# Requiere Python >= 3.10 cuando el token está presente.
OBSERVATORY_URL=https://llm-web-production.up.railway.app
OBSERVATORY_TOKEN=   # obs_sk_...

# Server
PORT=8000
