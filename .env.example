# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=private-key.pem
GITHUB_WEBHOOK_SECRET=

# Proveedor del análisis semántico: "anthropic" (default) o "openai"
LLM_PROVIDER=anthropic

# Anthropic (usado si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Modelo: claude-haiku-4-5 (barato, por defecto) o claude-sonnet-4-6 (mejor detección)
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI (usado si LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Modelo: gpt-4o-mini (barato, por defecto) o gpt-4o (mejor detección)
OPENAI_MODEL=gpt-4o-mini

# Tope de caracteres del diff por archivo (control de costo)
MAX_PATCH_CHARS=12000
# Máximo de comentarios inline publicados por PR (el resto va solo en el resumen)
MAX_INLINE_COMMENTS=15

# --- Controles de costo opcionales (todos "false" por defecto) ---
# OJO: activar los tres a la vez deja los reviews casi vacíos (se multiplican:
# RISKY salta la mayoría de archivos, TWO_PASS salta los que quedan sin hallazgo
# estático, y ONLY_CRITICAL calla los pocos que llegan a Claude salvo 🔴).
#
# Combinación recomendada (costo bajo pero los reviews SÍ muestran contenido):
#   ONLY_CRITICAL_SEVERITY=false   # devuelve 🟡/🔵, así el review no queda mudo
#   TWO_PASS_MODE=false            # evita el doble-filtro que silencia archivos riesgosos
#   RISKY_FILES_ONLY=true          # única palanca de costo: revisa a fondo solo lo que importa
# Con esto solo verás reviews en archivos riesgosos (auth/pago/db o diffs grandes);
# los demás quedan sin comentarios semánticos. Para revisar TODOS los archivos pero
# barato, pon RISKY_FILES_ONLY=false y baja MAX_PATCH_CHARS (p. ej. 8000).
#
# Solo reporta bugs graves (🔴); omite 🟡/🔵
ONLY_CRITICAL_SEVERITY=false
# Solo llama a Claude si Ruff/ESLint ya encontró algo en el archivo
TWO_PASS_MODE=false
# Solo llama a Claude en archivos "riesgosos" (nombre sensible o diff grande)
RISKY_FILES_ONLY=false
RISKY_FILE_PATTERNS=auth,payment,pago,db,database,secret,crypto,session,token
RISKY_PATCH_SIZE=300

# LLM Observatory (métricas de uso/costo de Claude)
# Si OBSERVATORY_TOKEN está vacío, el bot funciona igual pero NO envía métricas.
# Requiere Python >= 3.10 cuando el token está presente.
OBSERVATORY_URL=https://llm-web-production.up.railway.app
OBSERVATORY_TOKEN=   # obs_sk_...

# Server
PORT=8000
