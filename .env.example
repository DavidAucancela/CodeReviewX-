# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=private-key.pem
GITHUB_WEBHOOK_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
# Modelo: claude-haiku-4-5 (barato, por defecto) o claude-sonnet-4-6 (mejor detección)
ANTHROPIC_MODEL=claude-haiku-4-5
# Tope de caracteres del diff por archivo (control de costo)
MAX_PATCH_CHARS=12000

# LLM Observatory (métricas de uso/costo de Claude)
# Si OBSERVATORY_TOKEN está vacío, el bot funciona igual pero NO envía métricas.
# Requiere Python >= 3.10 cuando el token está presente.
OBSERVATORY_URL=https://llm-web-production.up.railway.app
OBSERVATORY_TOKEN=   # obs_sk_...

# Server
PORT=8000
